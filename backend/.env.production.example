# ==========================================
# Cosmic Connect - Production Environment Configuration
# ==========================================

# 1. TEMEL AYARLAR (SERVER)
NODE_ENV=production
PORT=3000

# 2. VERİTABANI BAĞLANTISI (POSTGRESQL)
# Örnek: "postgresql://kullanici_adi:sifre@sunucu_adresi:5432/veritabani_adi?schema=public"
# Supabase veya Neon.tech'ten aldığınız bağlantı kopyasını buraya yapıştırın.
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/cosmicconnect?schema=public"

# 3. GÜVENLİK VE ŞİFRELEME
# JWT Token şifrelemesi için güvenli, karmaşık ve en az 32 karakterlik bir gizli anahtar
JWT_SECRET="PLEASE_CHANGE_THIS_TO_A_VERY_LONG_SECURE_RANDOM_STRING_123!"

# 4. AĞ (CORS & FRONTEND)
# FRONTEND_URL parametresi eğer dışarıya açık özel bir web proxy varsa kullanılır.
# Sadece mobil (Capacitor) kullanılacaksa burası boş/varsayılan kalabilir, 
# sistem otomatik olarak Capacitor "http://localhost" originlerine izin verecektir.
FRONTEND_URL="capacitor://localhost"
