generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String?
  bio               String?
  avatar            String?
  hobby             String?
  music             String?
  weekend           String?
  lookingForHobby   String?
  lookingForMusic   String?
  lookingForWeekend String?
  gender            String?
  interestedIn      String?
  role              String   @default("STANDARD")
  birthDate         DateTime
  birthTime         String
  latitude          Float
  longitude         Float
  sunSign           String
  moonSign          String
  risingSign        String
  planetPositions   Json?    // Meeus/Moshier ile bir kez hesaplanıp saklanacak (CPU optimizasyonu)
  stardustBalance   Int      @default(0)
  diamondBalance    Int      @default(0) // Çekilebilir Bakiye (Elmas)
  matchScore        Int      @default(100)
  cosmicStatus      String?

  // Premium & Economy Fields
  isPremium       Boolean   @default(false)
  dailySwipes     Int       @default(0)
  lastSwipeDate   DateTime?
  
  // Online Status
  isOnline        Boolean   @default(false)
  lastSeen        DateTime?
  superLikesLeft  Int       @default(0)
  extraTimeLeft   Int       @default(0)

  // Security Fields
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean   @default(false)
  dailyMatchPasses Int      @default(50)
  lastDailyReward DateTime?
  loginStreak     Int       @default(0)
  xp              Int       @default(0)
  level           Int       @default(1)
  lastDailyTarot  DateTime?
  badges          Json      @default("[]")

  // Push Notifications (FEAT-06) — stores Expo/Capacitor push token
  pushToken String?

  // Password Reset fields
  resetToken        String?
  resetTokenExpires DateTime?

  // Daily Quests (FEAT-08)
  dailyQuestMatches  Int       @default(0)
  dailyQuestMessages Int       @default(0)
  dailyQuestClaimed  Boolean   @default(false)
  lastQuestReset     DateTime?

  // Cosmic Karma (FEAT-10)
  karma              Int       @default(100)

  createdAt DateTime @default(now())

  sentMessages         Message[]      @relation("SentMessages")
  receivedMessages     Message[]      @relation("ReceivedMessages")
  friendshipsUser1     Friendship[]   @relation("FriendshipUser1")
  friendshipsUser2     Friendship[]   @relation("FriendshipUser2")
  groupMessages        GroupMessage[] @relation("GroupSender")
  sentGifts            Gift[]         @relation("SentGifts")
  receivedGifts        Gift[]         @relation("ReceivedGifts")
  photos               Photo[]
  fortuneTellerProfile FortuneTeller?
  appointments         Appointment[]
  tellerComments       TellerComment[]
  tellerApplication    TellerApplication?
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  dailyFriendRequests  Int       @default(0)
  lastFriendRequestDate DateTime?

  sentReports        Report[] @relation("ReportedBy")
  receivedReports    Report[] @relation("ReportedUser")
  notifications      Notification[]
  blockedUsers       BlockedUser[] @relation("BlockerUser")
  blockedBy          BlockedUser[] @relation("BlockedUserRel")

  matchQueue         MatchQueue?
  matchRooms1        MatchRoom[] @relation("MatchUser1")
  matchRooms2        MatchRoom[] @relation("MatchUser2")
  ownedParties       PartyRoom[]

  ledFamilies        Family[]      @relation("FamilyLeader")
  familyMembership   FamilyMember?
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "MESSAGE", "FRIEND_REQUEST", "MATCH", "GIFT", "SYSTEM" vs.
  title       String
  content     String
  isRead      Boolean  @default(false)
  actionUrl   String?  // Bildirime tıklandığında gidilecek URL (örn. "/messages" veya "/profile/id")
  entityId    String?  // İlgili datanın ID'si (örn. mesaj ID veya friend request ID)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model GroupMessage {
  id        String   @id @default(cuid())
  roomId    String   // Zodiac sign name e.g., 'Aries'
  senderId  String
  sender    User     @relation("GroupSender", fields: [senderId], references: [id])
  content   String?
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([roomId])
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  status    String   @default("FRIEND") // Can be "MATCH" or "FRIEND"

  user1 User @relation("FriendshipUser1", fields: [user1Id], references: [id])
  user2 User @relation("FriendshipUser2", fields: [user2Id], references: [id])

  @@index([user2Id])
  @@index([user1Id, user2Id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String?
  imageUrl   String?
  audioUrl   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
  @@index([createdAt])
}

model FortuneTeller {
  id           String @id @default(uuid())
  userId       String @unique
  skills       String
  bio          String
  rating       Float  @default(0)
  reviewCount  Int    @default(0)
  fortuneTypes String @default("TAROT,KAHVE,EL")
  
  iban                 String?
  // withdrawableBalance is deprecated in favor of User.diamondBalance

  user         User            @relation(fields: [userId], references: [id])
  appointments Appointment[]
  comments     TellerComment[]
  payouts      PayoutRequest[]
}

model Appointment {
  id              String   @id @default(uuid())
  tellerId        String
  userId          String
  appointmentDate DateTime
  status          String   @default("PENDING")
  stardustPrice   Int
  fortuneType     String?  @default("TAROT")
  question        String?
  imageUrl        String?
  audioUrl        String?
  interpretation  String?
  userRating      Int?

  teller FortuneTeller @relation(fields: [tellerId], references: [id])
  user   User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tellerId])
  @@index([status])
}

model HoroscopeTemplate {
  id       Int    @id @default(autoincrement())
  sign     String
  category String
  content  String

  @@index([sign, category])
}

model TellerComment {
  id        String   @id @default(uuid())
  tellerId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())

  teller FortuneTeller @relation(fields: [tellerId], references: [id])
  user   User          @relation(fields: [userId], references: [id])

  @@index([tellerId])
  @@index([userId])
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model TellerApplication {
  id           String   @id @default(uuid())
  userId       String   @unique
  experience   String // How long they have been reading, background
  fortuneTypes String // Comma separated codes
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Gift {
  id              String   @id @default(uuid())
  senderId        String
  receiverId      String
  giftType        String
  stardustCost    Int
  roomId          String?
  comboCount      Int      @default(1)
  isLucky         Boolean  @default(false)
  luckyMultiplier Float?
  luckyWonAmount  Int?
  createdAt       DateTime @default(now())

  sender   User @relation("SentGifts", fields: [senderId], references: [id])
  receiver User @relation("ReceivedGifts", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([roomId, createdAt])
  @@index([receiverId, createdAt])
}

model LuckyGiftOddsTier {
  id         String  @id @default(cuid())
  label      String
  weightPct  Float
  multiplier Float
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)
}

model PartyGift {
  id              String   @id @default(cuid())
  giftKey         String   @unique
  name            String
  icon            String?
  price           Int
  category        String
  animationUrl    String?
  animationTier   String   @default("TOAST")
  isLuckyEligible Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model PkBattle {
  id           String    @id @default(cuid())
  roomAId      String
  roomBId      String
  status       String    @default("PENDING")
  durationSec  Int       @default(300)
  startedAt    DateTime?
  endsAt       DateTime?
  scoreA       Int       @default(0)
  scoreB       Int       @default(0)
  winnerRoomId String?
  createdAt    DateTime  @default(now())

  @@index([roomAId])
  @@index([roomBId])
  @@index([status])
}

model Family {
  id           String   @id @default(cuid())
  name         String   @unique
  leaderId     String
  avatarUrl    String?
  announcement String?
  level        Int      @default(1)
  totalScore   Int      @default(0)
  createdAt    DateTime @default(now())

  leader  User           @relation("FamilyLeader", fields: [leaderId], references: [id])
  members FamilyMember[]

  @@index([leaderId])
}

model FamilyMember {
  id                String   @id @default(cuid())
  familyId          String
  userId            String   @unique
  role              String   @default("MEMBER")
  contributionScore Int      @default(0)
  joinedAt          DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([familyId])
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id])
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id])

  @@index([senderId, status])
  @@index([receiverId, status])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reportedId  String
  reason      String
  description String?
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())

  reporter    User @relation("ReportedBy", fields: [reporterId], references: [id])
  reported    User @relation("ReportedUser", fields: [reportedId], references: [id])

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}
model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockerUser", fields: [blockerId], references: [id])
  blocked User @relation("BlockedUserRel", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model ProcessedWebhook {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

model PayoutRequest {
  id           String   @id @default(uuid())
  tellerId     String
  amount       Int      // Çekilmek istenen Yıldız Tozu miktarı
  iban         String   // Gönderilecek IBAN
  status       String   @default("PENDING") // PENDING, COMPLETED, REJECTED
  createdAt    DateTime @default(now())
  processedAt  DateTime?

  teller       FortuneTeller @relation(fields: [tellerId], references: [id])

  @@index([tellerId])
  @@index([status])
}

model MatchQueue {
  userId      String   @id
  socketId    String
  matchScore  Int
  isPremium   Boolean
  karma       Int
  sunSign     String?
  joinedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MatchRoom {
  id                String   @id @default(uuid())
  p1Id              String
  p2Id              String
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  extensionsCount   Int      @default(0)

  user1 User @relation("MatchUser1", fields: [p1Id], references: [id], onDelete: Cascade)
  user2 User @relation("MatchUser2", fields: [p2Id], references: [id], onDelete: Cascade)

  @@index([p1Id])
  @@index([p2Id])
}

model PartyRoom {
  id                String   @id @default(uuid())
  ownerId           String
  title             String
  description       String?
  imageUrl          String?
  coverUrl          String?
  welcomeMessage    String?
  announcement      String?
  password          String?
  isLocked          Boolean  @default(false)
  micMode           String   @default("ALL") // ALL, MEMBERS, INVITE_ONLY
  seatLayout        String   @default("8+1") // "16", "15+1", "8+1", "10", "12", "20", "30"
  autoInvite        Boolean  @default(false)
  chatEnabled       Boolean  @default(true)
  maxParticipants   Int      @default(50)
  currentCount      Int      @default(0)
  isActive          Boolean  @default(true)
  frameUrl          String?
  backgroundUrl     String?
  entryEffect       String?
  seatLabels        Json?
  moderators        Json     @default("[]")
  bannedUsers       Json     @default("[]")
  createdAt         DateTime @default(now())

  owner             User     @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([isActive])
}
