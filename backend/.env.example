# ===========================================
# Cosmic Connect Backend — Environment Config
# ===========================================

# PostgreSQL veritabanı bağlantı dizesi
# Neon.tech (free tier): https://neon.tech adresinden alınabilir
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@host:5432/cosmic_connect?schema=public"

# JWT Secret — GÜVENLİ, rastgele, en az 32 karakter olmalı
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="BURAYA_GUCLU_BIR_SECRET_GIRIN"

# Server port
PORT=3000

# Frontend URL (CORS için, mobil uygulama kullanıyorsanız * veya capacitor:// olabilir)
FRONTEND_URL="capacitor://localhost"

# Node ortamı: development | production | test
NODE_ENV=production
